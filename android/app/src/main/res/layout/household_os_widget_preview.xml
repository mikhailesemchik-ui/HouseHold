<?xml version="1.0" encoding="utf-8"?>
<!-- Static widget-picker preview (Android 12+): same look as the live widget,
     counts only, no task names. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/household_os_widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Tasks"
        android:textColor="#20231F"
        android:textSize="19sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="3 to do"
        android:textColor="#747A72"
        android:textSize="12sp" />
</LinearLayout>
