# Local environment / secrets — never commit these
.env
.env.*
!.env.example

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Household device wrapper — generated screenshots/dumps, never commit
/tools/device/output/

# Working screenshot captures — only docs/screenshots/portfolio/ is tracked
/docs/screenshots/raw/

# macOS metadata (AppleDouble, Finder)
._*
.DS_Store

# Local environment and secrets
defines*.json
.env.keys
**/GoogleService-Info.plist

# Private signing material
*.p12
*.p8
*.mobileprovision
*.cer
*.jks
*.keystore
key.properties

# Local database exports
*.dump
*.sql.gz

# Local Claude Code settings
.claude/settings.local.json

# Local Supabase CLI state (linked project, pinned versions)
/supabase/.temp/

# Local-only reference images (third-party or private captures)
/docs/new_design/telegram_glass/
